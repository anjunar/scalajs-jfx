{
  "name": "@anjunar/scalajs-jfx",
  "version": "3.0.2",
  "description": "Default component CSS for the scalajs-jfx Scala.js modules.",
  "type": "module",
  "license": "MIT",
  "author": "Patrick Bittner",
  "homepage": "https://github.com/anjunar/scalajs-jfx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjunar/scalajs-jfx.git",
    "directory": "npm/scalajs-jfx"
  },
  "bugs": {
    "url": "https://github.com/anjunar/scalajs-jfx/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "verify": "node scripts/build-design-registry.mjs --check && node scripts/verify.mjs && node --test scripts/preferences.test.mjs",
    "build:registry": "node scripts/build-design-registry.mjs"
  },
  "sideEffects": [
    "*.css",
    "index.js"
  ],
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./index.css": "./index.css",
    "./css": "./index.css",
    "./package.json": "./package.json",
    "./preferences": {
      "types": "./preferences.d.ts",
      "import": "./preferences.js"
    }
  },
  "files": [
    "index.js",
    "index.css",
    "action",
    "base",
    "control",
    "form",
    "layout",
    "README.md",
    "designs",
    "preferences.js",
    "preferences.d.ts"
  ]
}
