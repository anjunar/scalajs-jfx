{
  "name": "@anjunar/scalajs-ui-router",
  "version": "1.0.0",
  "description": "The TypeScript routing API of UI 3: route tables, nested outlets and navigating links, projected onto the ui.router.Router that runs in the Scala.js runtime published as @anjunar/scalajs-ui-bridge.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "test:consumer": "vitest run --config vitest.consumer.config.ts",
    "verify": "npm run typecheck && npm run test && npm run test:consumer"
  },
  "peerDependencies": {
    "@anjunar/scalajs-ui-core": "^1.0.0",
    "@anjunar/scalajs-ui-bridge": "^1.0.0",
    "@anjunar/scalajs-ui": "^1.0.0"
  },
  "devDependencies": {
    "@anjunar/scalajs-ui-core": "*",
    "@anjunar/scalajs-ui": "*",
    "@anjunar/scalajs-ui-bridge": "*",
    "@types/node": "^22.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "author": "Patrick Bittner",
  "homepage": "https://github.com/anjunar/scalajs-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjunar/scalajs-ui.git",
    "directory": "npm/scalajs-ui-router"
  },
  "bugs": {
    "url": "https://github.com/anjunar/scalajs-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
