{
  "name": "jfx-demo",
  "private": true,
  "version": "0.0.0",
  "description": "A real consumer app for @anjunar/jfx + @anjunar/scalajs-jfx-bridge -- Vite dev server, Express SSR, hydration. The Vite-side counterpart to the repo root's own application/ setup.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.ts",
    "start": "cross-env NODE_ENV=production node server.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@anjunar/jfx": "file:../jfx",
    "@anjunar/scalajs-jfx": "file:../scalajs-jfx",
    "@anjunar/scalajs-jfx-bridge": "file:../scalajs-jfx-bridge",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
