{
  "name": "scalajs-ui-demo",
  "private": true,
  "version": "1.0.0",
  "description": "A real consumer of @anjunar/scalajs-ui-core + @anjunar/scalajs-ui-router + @anjunar/scalajs-ui-bridge -- Vite dev server, Express SSR, hydration, client-side routing, plus Node runners that render the page bodies against the stub and against the linked Scala.js runtime. The Vite-side counterpart to the repo root's own scalajs-ui-demo/ setup.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "prerender": "node scripts/prerender-pages.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "npm run build:node && node dist/node/node/stub.js",
    "demo:bridge": "npm run build:node && node dist/node/node/bridge.js",
    "demo:scope": "npm run build:node && node dist/node/node/scope-rules.js",
    "verify:runtime": "node scripts/verify-single-runtime.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify": "npm run typecheck && npm run build && npm run verify:runtime && npm run verify:pages"
  },
  "dependencies": {
    "@anjunar/scalajs-ui-controls": "*",
    "@anjunar/scalajs-ui-core": "*",
    "@anjunar/scalajs-ui-editor": "*",
    "@anjunar/scalajs-ui-forms": "*",
    "@anjunar/scalajs-ui-json": "*",
    "@anjunar/scalajs-ui-router": "*",
    "@anjunar/scalajs-ui-viewport": "*",
    "@anjunar/scalajs-ui": "*",
    "@anjunar/scalajs-ui-bridge": "*",
    "@anjunar/scalajs-lexical": "^1.0.10",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
