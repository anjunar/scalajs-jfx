{
  "name": "scalajs-jfx",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "npm/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node server/server.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.js",
    "start": "cross-env NODE_ENV=production node server/server.mjs",
    "generate:site-metadata": "node tools/generate-site-metadata.mjs",
    "prerender": "node server/prerender-pages.mjs"
  },
  "dependencies": {
    "@anjunar/scalajs-jfx": "*",
    "@anjunar/scalajs-lexical": "^1.0.9",
    "@anjunar/ui": "^1.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16"
  }
}
